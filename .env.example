# ─────────────────────────────────────────────────────────────────────────────
# Knot'ily server settings. Copy to .env for local development (never commit .env).
# On Vercel, set the same names under Project → Settings → Environment Variables:
#   "Production" scope  → the live shop (branch main)
#   "Preview" scope, branch "develop" → the Testing environment
# Generate the secret keys with:  npm run keys
# ─────────────────────────────────────────────────────────────────────────────

# development | testing | production   (testing shows the yellow banner and [TESTING] email subjects)
APP_ENV=development
# Public address of the site (no trailing slash). Email links point here.
SITE_URL=http://localhost:5173
# Sites allowed to call the API (comma separated). Usually the same as SITE_URL.
ALLOWED_ORIGINS=http://localhost:5173
# true on https sites (set automatically when SITE_URL starts with https://)
# COOKIE_SECURE=false

# ── Supabase (Project Settings → API) ───────────────────────────────────────
SUPABASE_URL=https://YOUR-TESTING-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Secret! Server only. Never put this in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for older projects that sign tokens with a shared secret (Project Settings → API → JWT secret)
# SUPABASE_JWT_SECRET=
STORAGE_BUCKET=product-media

# ── Encryption of personal data (npm run keys) ───────────────────────────────
# Each environment gets its OWN keys. Losing them means losing the encrypted data:
# keep a copy in your password manager. Never change BLIND_INDEX_KEY once live.
DATA_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_32_BYTE_BASE64"}
DATA_ENCRYPTION_KEY_ID=v1
BLIND_INDEX_KEY=
SERVER_TOKEN_SECRET=

# ── Payments ─────────────────────────────────────────────────────────────────
# razorpay (Testing + Production) or mock (your own computer only; refused in production)
PAYMENT_PROVIDER=mock
# Testing: rzp_test_… keys (free, no real money). Production: rzp_live_… keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → secret you chose for https://YOUR-SITE/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=Knot'ily <orders@knotily.in>
# Fallback address for owner alerts (the dashboard setting wins when set)
OWNER_ALERT_EMAIL=
# Local only: write emails to this folder instead of sending them
MAIL_OUTBOX_DIR=.outbox

# ── Scheduled clean-up (Vercel sends it as "Authorization: Bearer …") ───────
CRON_SECRET=

# ── Vercel only: keep the raw request body so Razorpay webhook signatures verify
NODEJS_HELPERS=0

# ── Front end (build time, public) ───────────────────────────────────────────
# Leave empty: the API is on the same domain. Only set if you host the API elsewhere.
VITE_API_BASE_URL=
VITE_SUPPORT_EMAIL=hello@knotily.in
